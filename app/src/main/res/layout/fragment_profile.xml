<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CBEEF3"
    android:fillViewport="true"
    android:theme="@style/NotesVisualColors">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp"
        android:background="@drawable/notes_visual_card"
        android:layout_margin="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="My Profile"
            android:textColor="#243238"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="View and update your information"
            android:textColor="#4B5D64"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Email address"
            android:textColor="#243238"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_profileEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:enabled="false"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:textColor="#243238"
            android:textColorHint="#4B5D64"
            android:textSize="16sp"
            android:backgroundTint="@color/notes_visual_control_tint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="First name"
            android:textColor="#243238"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_profileFirstName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="First name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="#243238"
            android:textColorHint="#4B5D64"
            android:textSize="16sp"
            android:backgroundTint="@color/notes_visual_control_tint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Last name"
            android:textColor="#243238"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_profileLastName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Last name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textColor="#243238"
            android:textColorHint="#4B5D64"
            android:textSize="16sp"
            android:backgroundTint="@color/notes_visual_control_tint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="New password"
            android:textColor="#243238"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_profilePassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Leave empty to keep current password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="#243238"
            android:textColorHint="#4B5D64"
            android:textSize="16sp"
            android:backgroundTint="@color/notes_visual_control_tint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirm new password"
            android:textColor="#243238"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_profileConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Confirm new password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="#243238"
            android:textColorHint="#4B5D64"
            android:textSize="16sp"
            android:backgroundTint="@color/notes_visual_control_tint" />

        <Button
            android:id="@+id/button_saveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:background="@drawable/notes_visual_button_primary"
            android:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>