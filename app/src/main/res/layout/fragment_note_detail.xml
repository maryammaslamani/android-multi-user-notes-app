<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/NotesVisualColors"
    android:background="#CBEEF3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/notes_visual_card"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#243238"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/button_detail_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/favorite"
                android:padding="10dp"
                android:src="@drawable/ic_favorite_outline"
                app:tint="#C32250" />

        </LinearLayout>

        <TextView
            android:id="@+id/textView_detail_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#4B5D64"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textView_detail_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#4B5D64"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#CBEEF3" />

        <TextView
            android:id="@+id/textView_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:textColor="#243238"
            android:textIsSelectable="true"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/button_edit_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/edit_note"
            android:background="@drawable/notes_visual_button_primary"
            android:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/button_email_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/send_by_email"
            android:background="@drawable/notes_visual_button_secondary"
            android:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/button_delete_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/delete_note"
            android:background="@drawable/notes_visual_card"
            android:backgroundTint="@null"
            android:textColor="#B3261E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:minHeight="52dp"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>