<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/NotesVisualColors"
    android:background="#CBEEF3">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_add_edit_note"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#218380"
        android:theme="@style/NotesVisualToolbarColors"
        app:popupTheme="@style/NotesVisualColors"
        app:subtitleTextColor="#FFFFFF"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/notes_visual_card"
            android:layout_margin="16dp">

            <EditText
                android:id="@+id/editText_note_title"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="@string/note_title_hint"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:singleLine="true"
                android:textColor="#243238"
                android:textColorHint="#4B5D64"
                android:textSize="20sp"
                android:backgroundTint="@color/notes_visual_control_tint"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editText_note_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="top|start"
                android:hint="@string/note_content_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="200dp"
                android:minLines="8"
                android:textColor="#243238"
                android:textColorHint="#4B5D64"
                android:textSize="16sp"
                android:backgroundTint="@color/notes_visual_control_tint"
                android:lineSpacingExtra="4dp" />

            <EditText
                android:id="@+id/editText_note_tag"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:hint="@string/note_tag_hint"
                android:inputType="textCapWords"
                android:maxLength="30"
                android:singleLine="true"
                android:textColor="#243238"
                android:textColorHint="#4B5D64"
                android:textSize="16sp"
                android:backgroundTint="@color/notes_visual_control_tint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/button_cancel_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel"
                    android:background="@drawable/notes_visual_button_secondary"
                    android:backgroundTint="@null"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="52dp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/button_save_note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/save"
                    android:background="@drawable/notes_visual_button_primary"
                    android:backgroundTint="@null"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minHeight="52dp"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
