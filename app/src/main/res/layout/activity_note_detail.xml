<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/NotesVisualColors"
    android:background="#CBEEF3">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_note_detail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#218380"
        android:theme="@style/NotesVisualToolbarColors"
        app:popupTheme="@style/NotesVisualColors"
        app:subtitleTextColor="#FFFFFF"
        app:titleTextColor="#FFFFFF" />

    <FrameLayout
        android:id="@+id/note_detail_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#CBEEF3" />

</LinearLayout>
