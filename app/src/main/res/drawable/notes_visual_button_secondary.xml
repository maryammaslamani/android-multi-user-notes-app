        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="#616161" /><corners android:radius="14dp" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="#218380" /><corners android:radius="14dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="#218380" /><corners android:radius="14dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
