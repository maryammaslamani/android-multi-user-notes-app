<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1AFFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle"><solid android:color="#79646A" /><corners android:radius="14dp" /></shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><solid android:color="#A71941" /><corners android:radius="14dp" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle"><solid android:color="#C32250" /><corners android:radius="14dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
